# Archivo de ejemplo para variables de entorno en Docker
# Copia este archivo a .env.production y ajusta los valores

# ============================================
# Base de datos PostgreSQL
# ============================================
POSTGRES_USER=smartpos
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=smartpos_db
POSTGRES_PORT=5432

# ============================================
# Aplicación
# ============================================
APP_PORT=3000
NODE_ENV=production

# ============================================
# URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ============================================
# Secrets (CAMBIAR EN PRODUCCIÓN)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-change-in-production-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production-min-32-chars

# ============================================
# Database URL (se construye automáticamente)
# ============================================
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# Redis (opcional)
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ============================================
# Email (opcional, configurar según tu proveedor)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@smartpos.com

# ============================================
# AI Services (opcional)
# ============================================
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OLLAMA_BASE_URL=http://host.docker.internal:11434
