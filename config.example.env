# Database Configuration
# Formato: postgresql://username:password@host:port/database
# 
# Parámetros de Pool de Conexiones (recomendados para producción):
# - connection_limit: Número máximo de conexiones en el pool (default: número de CPUs * 2 + 1)
# - pool_timeout: Tiempo máximo (segundos) para obtener una conexión del pool (default: 10)
# - connect_timeout: Tiempo máximo (segundos) para establecer conexión inicial (default: 5)
# - statement_timeout: Tiempo máximo (ms) para ejecutar una query (opcional, para prevenir queries colgadas)
#
# Ejemplo completo:
# DATABASE_URL="postgresql://user:pass@host:port/db?connection_limit=20&pool_timeout=20&connect_timeout=10"
#
# Para desarrollo:
DATABASE_URL="postgresql://postgres:Ancasi96nuwe+@localhost:5432/ventas-sas?connection_limit=10&pool_timeout=20"
#
# Para producción (ajustar según carga esperada):
# DATABASE_URL="postgresql://user:pass@host:port/db?connection_limit=25&pool_timeout=20&connect_timeout=10"

# Development Configuration
NEXT_PUBLIC_DEV_REDIRECT_URL=http://localhost:3000/administracion/dashboard

# Environment
NODE_ENV=development

# JWT Configuration (separado por sistema)
# Admin (usado para /administracion/**)
ADMIN_JWT_SECRET=change-this-admin-secret
ADMIN_JWT_EXPIRES_IN=7d

# SAS (usado para /[slug]/**)
SAS_JWT_SECRET=change-this-sas-secret
SAS_JWT_EXPIRES_IN=7d

# App Configuration (si no usas NextAuth, puedes eliminar estas claves)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-nextauth-secret-here

# CSRF Protection (habilitar en producción)
# ENABLE_CSRF=true
# CSRF_SECRET=change-this-csrf-secret (si no se especifica, usa JWT_SECRET)

# Caché
# CACHE_TTL=300 (TTL por defecto en segundos, 5 minutos)

# API Documentation
# NEXT_PUBLIC_API_URL=http://localhost:3000 (URL base para documentación Swagger)

# Logging Configuration
# Nivel de logging: trace, debug, info, warn, error, fatal
# En desarrollo: debug (muestra todo)
# En producción: warn o error (solo warnings/errores)
LOG_LEVEL=debug

# Habilitar logging de performance (opcional)
# LOG_PERFORMANCE=true

# 2FA Encryption Key (para encriptar secrets de 2FA)
# Debe ser una cadena de exactamente 32 caracteres
# En producción, generar con: openssl rand -hex 16
ENCRYPTION_KEY=your-32-char-encryption-key-here-change-in-production
