# Database Configuration
# 
# OPCIÓN 1: Supabase (Recomendado para producción)
# =====================================================
# Supabase usa PgBouncer para connection pooling, por lo que necesitas 2 URLs:
# 
# DATABASE_URL: Para queries normales (usa pooling en puerto 6543)
# DIRECT_URL: Para migraciones (conexión directa en puerto 5432)
#
# Obtén tus credenciales en: https://supabase.com/dashboard/project/_/settings/database
#
# Ejemplo Supabase:
# DATABASE_URL="postgresql://postgres.bcixvjmnxviawfbmsffg:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.bcixvjmnxviawfbmsffg:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:5432/postgres"
#
# OPCIÓN 2: PostgreSQL Local o Neon (Desarrollo)
# =====================================================
# Para desarrollo local o Neon, solo necesitas DATABASE_URL:
DATABASE_URL="postgresql://postgres:Ancasi96nuwe+@localhost:5432/ventas-sas?connection_limit=10&pool_timeout=20"
# DIRECT_URL no es necesario para PostgreSQL local (Prisma usará DATABASE_URL automáticamente)

# Development Configuration
NEXT_PUBLIC_DEV_REDIRECT_URL=http://localhost:3000/administracion/dashboard

# Environment
NODE_ENV=development

# JWT Configuration (separado por sistema)
# Admin (usado para /administracion/**)
ADMIN_JWT_SECRET=change-this-admin-secret
ADMIN_JWT_EXPIRES_IN=7d

# SAS (usado para /[slug]/**)
SAS_JWT_SECRET=change-this-sas-secret
SAS_JWT_EXPIRES_IN=7d

# CSRF Protection (habilitar en producción)
# ENABLE_CSRF=true
# CSRF_SECRET=change-this-csrf-secret (si no se especifica, usa JWT_SECRET)

# Caché
# CACHE_TTL=300 (TTL por defecto en segundos, 5 minutos)

# API Documentation
# NEXT_PUBLIC_API_URL=http://localhost:3000 (URL base para documentación Swagger)

# Logging Configuration
# Nivel de logging: trace, debug, info, warn, error, fatal
# En desarrollo: debug (muestra todo)
# En producción: warn o error (solo warnings/errores)
LOG_LEVEL=debug

# Habilitar logging de performance (opcional)
# LOG_PERFORMANCE=true

# 2FA Encryption Key (para encriptar secrets de 2FA)
# Debe ser una cadena de exactamente 32 caracteres
# En producción, generar con: openssl rand -hex 16
ENCRYPTION_KEY=your-32-char-encryption-key-here-change-in-production

# Seed Secret (opcional, para proteger el endpoint de seed en producción)
# Generar con: openssl rand -hex 16
# SEED_SECRET=your-seed-secret-here

# Google Custom Search API Configuration (Opcional)
# Para obtener estas credenciales, sigue la guía en GOOGLE_CUSTOM_SEARCH_SETUP.md
GOOGLE_CUSTOM_SEARCH_API_KEY=AIzaSyBG0ingDGs5f4X11O8KqG1cIfCLq6e-SCo
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=1657a17f97e7a46d8

# Google Generative AI (Gemini) API Configuration (Opcional)
# Para obtener la API key, visita https://aistudio.google.com/
# GOOGLE_GENERATIVE_AI_API_KEY=tu_api_key_aqui
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyBMcQGWk91xRY3teMRT3eaT6v2S-5uwJdM